# BrainCodeAI Frontend - Production Environment Variables
# Copy this file to .env.production and modify as needed

# API Configuration
# Backend API base URL for production (replace with your actual production URL)
VITE_API_BASE_URL=https://your-production-api.com

# Production Settings
VITE_NODE_ENV=production
VITE_DEBUG=false

# Optional: Analytics or monitoring (uncomment and configure as needed)
# VITE_ANALYTICS_ID=your_analytics_id
# VITE_SENTRY_DSN=your_sentry_dsn

# Optional: Feature flags for production
# VITE_ENABLE_ANALYTICS=true
# VITE_ENABLE_ERROR_REPORTING=true
