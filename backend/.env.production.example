# BrainCodeAI Backend - Production Environment Variables
# Copy this file to .env.production and modify as needed

PORT=4000
NODE_ENV=production
FRONTEND_URL=https://your-frontend-domain.com

# OpenAI Configuration
OPENAI_API_KEY=your_production_openai_api_key

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=5

# Database
DATABASE_URL=postgresql://username:password@your-db-host:5432/your_production_db
DB_HOST=your_production_db_host
DB_PORT=5432
DB_NAME=your_production_db_name
DB_USER=your_production_db_username
DB_PASSWORD=your_production_db_password

# Auth0
AUTH0_DOMAIN=your-auth0-domain.auth0.com
AUTH0_AUDIENCE=https://your-api-audience
