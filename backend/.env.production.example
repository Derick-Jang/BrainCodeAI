# BrainCodeAI Backend - Production Environment Variables
# Set these in Railway (Variables), not as a committed .env file

PORT=4000
NODE_ENV=production
# Your Vercel frontend URL (comma-separate multiple if needed)
FRONTEND_URL=https://braincode-ai.vercel.app

# OpenAI Configuration
OPENAI_API_KEY=your_production_openai_api_key

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=5

# Database — prefer Railway's DATABASE_URL reference:
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# Use the private URL when the backend and Postgres are in the same Railway project.
DATABASE_URL=postgresql://username:password@your-db-host:5432/your_production_db

# Optional fallback if DATABASE_URL is not set
# DB_HOST=${{Postgres.PGHOST}}
# DB_PORT=${{Postgres.PGPORT}}
# DB_NAME=${{Postgres.PGDATABASE}}
# DB_USER=${{Postgres.PGUSER}}
# DB_PASSWORD=${{Postgres.PGPASSWORD}}

# Auth0 (must match frontend VITE_AUTH0_* audience/domain)
AUTH0_DOMAIN=your-auth0-domain.auth0.com
AUTH0_AUDIENCE=https://your-api-audience
